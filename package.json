{
  "name": "saas-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "cd e2e && playwright test",
    "test:e2e:headed": "cd e2e && playwright test --headed",
    "test:e2e:debug": "cd e2e && PWDEBUG=1 playwright test --debug",
    "test:e2e:ui": "cd e2e && playwright test --ui",
    "test:e2e:report": "cd e2e && playwright show-report playwright-report",
    "test:e2e:docker": "cd e2e && docker compose up --build --abort-on-container-exit",
    "test:e2e:docker:down": "cd e2e && docker compose down -v",
    "test:e2e:ci": "cd e2e && playwright test --reporter=list,html,junit"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "playwright": "^1.41.0",
    "dotenv": "^16.3.1",
    "wait-on": "^7.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
