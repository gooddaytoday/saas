{
  "name": "e2e-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report playwright-report",
    "test:ci": "playwright test --reporter=list,html,junit",
    "test:e2e:ci": "playwright test --reporter=list,html,junit"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/node": "^20.10.4",
    "typescript": "^5.3.3",
    "mongodb-memory-server": "^9.1.3",
    "mongoose": "^8.0.3",
    "dotenv": "^16.3.1"
  }
}
