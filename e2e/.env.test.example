# Server Ports
E2E_API_PORT=8000
E2E_APP_PORT=3000

# URLs
E2E_API_URL=http://localhost:8000
E2E_APP_URL=http://localhost:3000

# Database (will be overridden by MongoDB Memory Server)
MONGO_URL_TEST=mongodb://localhost:27017/test

# API Environment Variables
NODE_ENV=test
SESSION_NAME=saas-test.sid
SESSION_SECRET=test-secret-key-for-e2e-only
COOKIE_DOMAIN=localhost

# API URLs for APP
NEXT_PUBLIC_URL_API=http://localhost:8000
URL_API=http://localhost:8000

# APP URLs
NEXT_PUBLIC_URL_APP=http://localhost:3000
URL_APP=http://localhost:3000

# Production URLs (not used in tests but required by code)
PRODUCTION_URL_API=http://localhost:8000
NEXT_PUBLIC_PRODUCTION_URL_API=http://localhost:8000
PRODUCTION_URL_APP=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL_APP=http://localhost:3000

# External Services (use test/mock credentials)
STRIPE_TEST_SECRETKEY=sk_test_mock
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLEKEY=pk_test_mock
GOOGLE_CLIENTID=mock-client-id
GOOGLE_CLIENTSECRET=mock-client-secret

# AWS (use localstack or mocks in tests)
AWS_ACCESSKEYID=test
AWS_SECRETACCESSKEY=test
AWS_REGION=us-east-1

# Email service (mock or disabled)
MAILCHIMP_API_KEY=mock-key
MAILCHIMP_SERVER_PREFIX=mock-server

# Logging
LOG_LEVEL=error
